---
---
<section class="stack" id="stack">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Stack</span>
      <h2><span class="lang-es">Stack Tecnológico</span><span class="lang-en">Tech Stack</span></h2>
      <p class="lang-es">Las herramientas con las que diseño, automatizo y opero infraestructura a diario.</p>
      <p class="lang-en">The tools I use to design, automate, and operate infrastructure every day.</p>
    </div>

    <div class="stack-grid">
      <div class="stack-card reveal">
        <div class="stack-card-head">
          <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg></div>
          <h3>Cloud &amp; IaC</h3>
        </div>
        <div class="stack-tags">
          <span class="stack-tag">AWS EKS</span><span class="stack-tag">ECS</span><span class="stack-tag">Lambda</span>
          <span class="stack-tag">API Gateway</span><span class="stack-tag">Organizations</span><span class="stack-tag">IAM</span>
          <span class="stack-tag">Terraform</span><span class="stack-tag">Terraform Cloud</span>
        </div>
      </div>

      <div class="stack-card reveal">
        <div class="stack-card-head">
          <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5Z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg></div>
          <h3>CI/CD &amp; GitOps</h3>
        </div>
        <div class="stack-tags">
          <span class="stack-tag">GitHub Actions</span><span class="stack-tag">Jenkins</span>
          <span class="stack-tag">Bitbucket Pipelines</span><span class="stack-tag">ArgoCD</span><span class="stack-tag">Helm</span>
        </div>
      </div>

      <div class="stack-card reveal">
        <div class="stack-card-head">
          <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg></div>
          <h3><span class="lang-es">Observabilidad</span><span class="lang-en">Observability</span></h3>
        </div>
        <div class="stack-tags">
          <span class="stack-tag">Grafana</span><span class="stack-tag">Prometheus</span>
          <span class="stack-tag">OpenTelemetry</span><span class="stack-tag">CloudWatch</span><span class="stack-tag">X-Ray</span>
        </div>
      </div>

      <div class="stack-card reveal">
        <div class="stack-card-head">
          <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path></svg></div>
          <h3><span class="lang-es">Seguridad</span><span class="lang-en">Security</span></h3>
        </div>
        <div class="stack-tags">
          <span class="stack-tag">mTLS</span><span class="stack-tag">AWS WAF</span><span class="stack-tag">Security Hub</span>
          <span class="stack-tag">Macie</span><span class="stack-tag">SonarCloud</span>
        </div>
      </div>

      <div class="stack-card reveal">
        <div class="stack-card-head">
          <div class="stack-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m4 17 6-6-6-6"></path><path d="M12 19h8"></path></svg></div>
          <h3><span class="lang-es">Scripting &amp; OS</span><span class="lang-en">Scripting &amp; OS</span></h3>
        </div>
        <div class="stack-tags">
          <span class="stack-tag">Linux (CLI)</span><span class="stack-tag">Bash</span><span class="stack-tag">Python</span>
          <span class="stack-tag">Groovy</span><span class="stack-tag">HCL</span><span class="stack-tag">YAML</span><span class="stack-tag">Node.js</span>
        </div>
      </div>
    </div>

    <div class="lang-row reveal">
      <span class="lang-chip lang-es"><b>Español</b> — Nativo</span>
      <span class="lang-chip lang-en"><b>Spanish</b> — Native</span>
      <span class="lang-chip lang-es"><b>Inglés</b> — Intermedio (técnico avanzado)</span>
      <span class="lang-chip lang-en"><b>English</b> — Intermediate (advanced technical)</span>
    </div>
  </div>
</section>
