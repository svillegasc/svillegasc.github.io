---
import Pipeline from './Pipeline.astro';
---
<section class="hero" id="inicio">
  <div class="container">
    <div>
      <div class="hero-top">
        <span class="availability-badge">
          <span class="availability-dot"></span>
          <span class="lang-es">Abierto a nuevas oportunidades</span>
          <span class="lang-en">Open to new opportunities</span>
        </span>
        <span class="eyebrow">Senior DevOps &amp; Cloud</span>
      </div>
      <h1 class="lang-es">Hola, soy <span>Santiago Villegas.</span></h1>
      <h1 class="lang-en">Hi, I'm <span>Santiago Villegas.</span></h1>

      <p class="hero-sub lang-es">Me encargo de que las aplicaciones estén siempre disponibles, seguras y funcionando bien. Ayudo a los equipos de tecnología a enfocarse en crear productos sin preocuparse por la infraestructura.</p>
      <p class="hero-sub lang-en">I make sure applications stay available, secure, and running smoothly. I help tech teams focus on building products without worrying about the infrastructure.</p>

      <p class="hero-meta lang-es">La Ceja, Antioquia, Colombia — disponible para remoto o híbrido</p>
      <p class="hero-meta lang-en">La Ceja, Antioquia, Colombia — open to remote or hybrid</p>

      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary">
          <span class="lang-es">Hablemos →</span><span class="lang-en">Let's talk →</span>
        </a>
        <a href="https://linkedin.com/in/santiagovillegas-castro-06175a9b/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          LinkedIn
        </a>
      </div>
    </div>

    <Pipeline />
  </div>
</section>
