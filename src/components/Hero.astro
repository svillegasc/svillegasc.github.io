---
import Pipeline from './Pipeline.astro';
---
<section class="hero" id="inicio">
  <div class="container">
    <div>
      <div class="hero-top">
        <span class="availability-badge">
          <span class="availability-dot"></span>
          <span class="lang-es">Abierto a nuevas oportunidades</span>
          <span class="lang-en">Open to new opportunities</span>
        </span>
        <span class="eyebrow">Senior DevOps &amp; Cloud</span>
      </div>
      <h1 class="lang-es">Hola, soy <span>Santiago Villegas.</span></h1>
      <h1 class="lang-en">Hi, I'm <span>Santiago Villegas.</span></h1>

      <p class="hero-sub lang-es">Diseño y automatizo infraestructura en la nube para que los equipos de desarrollo entreguen software más rápido, con menos fricción y sin sorpresas en producción.</p>
      <p class="hero-sub lang-en">I design and automate cloud infrastructure so development teams can ship faster, with less friction and fewer surprises in production.</p>

      <p class="hero-meta lang-es">La Ceja, Antioquia, Colombia — disponible para remoto o híbrido</p>
      <p class="hero-meta lang-en">La Ceja, Antioquia, Colombia — open to remote or hybrid</p>

      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-number">8+</span>
          <span class="hero-stat-label lang-es">años de experiencia</span>
          <span class="hero-stat-label lang-en">years of experience</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">50+</span>
          <span class="hero-stat-label lang-es">servicios en producción</span>
          <span class="hero-stat-label lang-en">services in production</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">75%</span>
          <span class="hero-stat-label lang-es">menos tiempo de deploy</span>
          <span class="hero-stat-label lang-en">faster deployments</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">30%</span>
          <span class="hero-stat-label lang-es">reducción en costos</span>
          <span class="hero-stat-label lang-en">cloud cost reduction</span>
        </div>
      </div>

      <div class="hero-cta">
        <a href="#contacto" class="btn btn-primary">
          <span class="lang-es">Hablemos →</span><span class="lang-en">Let's talk →</span>
        </a>
        <a href="https://linkedin.com/in/santiagovillegas-castro-06175a9b/" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
          LinkedIn
        </a>
      </div>
    </div>

    <Pipeline />
  </div>
</section>
