---
---
<section class="what-looking" id="que-busco">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><span class="lang-es">Lo que busco</span><span class="lang-en">What I'm looking for</span></span>
      <h2><span class="lang-es">Próximo paso profesional</span><span class="lang-en">Next professional step</span></h2>
    </div>

    <div class="what-looking-grid">
      <div class="what-looking-card reveal">
        <div class="what-looking-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <h3 class="lang-es">Rol</h3>
        <h3 class="lang-en">Role</h3>
        <p class="lang-es">Cloud Engineer o DevOps Senior/Semi-Senior</p>
        <p class="lang-en">Cloud Engineer or DevOps Senior/Semi-Senior</p>
      </div>

      <div class="what-looking-card reveal">
        <div class="what-looking-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3 class="lang-es">Modalidad</h3>
        <h3 class="lang-en">Modality</h3>
        <p class="lang-es">Remoto preferido, abierto a híbrido</p>
        <p class="lang-en">Remote preferred, open to hybrid</p>
      </div>

      <div class="what-looking-card reveal">
        <div class="what-looking-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <h3 class="lang-es">Tipo de empresa</h3>
        <h3 class="lang-en">Company type</h3>
        <p class="lang-es">Empresa de tecnología, consultora o corporativa</p>
        <p class="lang-en">Tech company, consultancy, or corporate</p>
      </div>
    </div>
  </div>
</section>
